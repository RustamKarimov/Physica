<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PhysicaStudio.Desktop.Controls"
             xmlns:resources="using:PhysicaStudio.Desktop.Resources"
             x:Class="PhysicaStudio.Desktop.Controls.PhysicaColorField">
  <Button x:Name="PickerButton" Classes="physica-color-field"
          AutomationProperties.Name="{x:Static resources:AppText.ChooseColor}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Border x:Name="CurrentSwatch" Width="25" Height="18" CornerRadius="3"
              BorderBrush="#8CA0AD" BorderThickness="1" VerticalAlignment="Center" />
      <TextBlock x:Name="CurrentHexText" Grid.Column="1" VerticalAlignment="Center"
                 FontFamily="Cascadia Mono,Consolas" FontSize="12.5" />
      <controls:PhysicaIcon Grid.Column="2" IconKey="chevron-down" Width="12" Height="12"
                            Stroke="#9FB1BC" VerticalAlignment="Center" />
    </Grid>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard"
              FlyoutPresenterClasses="physica-color-flyout">
        <Border Classes="physica-color-menu" Width="324">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{x:Static resources:AppText.ThemeColors}" Classes="color-menu-heading" />
              <TextBlock x:Name="ThemeNameText" Grid.Column="1" Classes="color-menu-meta" />
            </Grid>
            <UniformGrid x:Name="ThemeSwatchGrid" Columns="6" Rows="5" HorizontalAlignment="Left" />

            <Border Height="1" Background="#2A3D49" Margin="0,1" />

            <TextBlock Text="{x:Static resources:AppText.StandardColors}" Classes="color-menu-heading" />
            <UniformGrid x:Name="StandardSwatchGrid" Columns="10" Rows="1" HorizontalAlignment="Left" />

            <StackPanel Spacing="7">
              <TextBlock Text="{x:Static resources:AppText.RecentColors}" Classes="color-menu-heading" />
              <TextBlock x:Name="RecentEmptyText" Text="{x:Static resources:AppText.NoRecentColors}"
                         Classes="color-menu-empty" />
              <UniformGrid x:Name="RecentSwatchGrid" Columns="10" Rows="1" HorizontalAlignment="Left" />
            </StackPanel>

            <Border Height="1" Background="#2A3D49" Margin="0,1" />

            <Button Classes="color-menu-action" Click="MoreColors_Click"
                    AutomationProperties.Name="{x:Static resources:AppText.MoreColors}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                <controls:PhysicaIcon IconKey="palette" Width="17" Height="17" Stroke="#9FD4F5" />
                <TextBlock Grid.Column="1" Text="{x:Static resources:AppText.MoreColors}"
                           VerticalAlignment="Center" />
                <controls:PhysicaIcon Grid.Column="2" IconKey="chevron-right" Width="11" Height="11"
                                      Stroke="#7F95A3" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
