<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="ChromeDeepest">#071018</Color>
    <Color x:Key="ChromeBase">#0D1821</Color>
    <Color x:Key="ChromeRaised">#14212B</Color>
    <Color x:Key="ChromeControl">#192A35</Color>
    <Color x:Key="ChromeHover">#223744</Color>
    <Color x:Key="ChromeSelected">#1B3B4B</Color>
    <Color x:Key="BorderSubtle">#263744</Color>
    <Color x:Key="BorderStrong">#3B5568</Color>
    <Color x:Key="TextPrimary">#EDF3F7</Color>
    <Color x:Key="TextSecondary">#AFBEC9</Color>
    <Color x:Key="TextMuted">#738695</Color>
    <Color x:Key="Selection">#168CFF</Color>
    <Color x:Key="Physics">#25C9C3</Color>
    <Color x:Key="Condition">#9B68D7</Color>
    <Color x:Key="Instruction">#F29A2E</Color>
    <Color x:Key="Valid">#52CC7A</Color>
    <Color x:Key="Warning">#E8B85B</Color>
    <Color x:Key="Error">#E36363</Color>

    <SolidColorBrush x:Key="ChromeDeepestBrush" Color="{StaticResource ChromeDeepest}" />
    <SolidColorBrush x:Key="ChromeBaseBrush" Color="{StaticResource ChromeBase}" />
    <SolidColorBrush x:Key="ChromeRaisedBrush" Color="{StaticResource ChromeRaised}" />
    <SolidColorBrush x:Key="ChromeControlBrush" Color="{StaticResource ChromeControl}" />
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="{StaticResource ChromeHover}" />
    <SolidColorBrush x:Key="ChromeSelectedBrush" Color="{StaticResource ChromeSelected}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource Selection}" />
    <SolidColorBrush x:Key="PhysicsBrush" Color="{StaticResource Physics}" />
    <SolidColorBrush x:Key="ConditionBrush" Color="{StaticResource Condition}" />
    <SolidColorBrush x:Key="InstructionBrush" Color="{StaticResource Instruction}" />
    <SolidColorBrush x:Key="ValidBrush" Color="{StaticResource Valid}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource ChromeBaseBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource ChromeControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{StaticResource ChromeSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
  </Style>

  <Style Selector="Button.title-tool">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-command">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.window-command.close:pointerover">
    <Setter Property="Background" Value="#B33B45" />
  </Style>
  <Style Selector="Button.ribbon-tab">
    <Setter Property="Height" Value="31" />
    <Setter Property="MinHeight" Value="31" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ribbon-tab:pointerover">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="#182B38" />
  </Style>
  <Style Selector="Button.present-compact">
    <Setter Property="Height" Value="27" />
    <Setter Property="MinHeight" Value="27" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="Background" Value="#176B67" />
    <Setter Property="BorderBrush" Value="#2E968E" />
  </Style>
  <Style Selector="Button.ribbon-command">
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MaxWidth" Value="90" />
    <Setter Property="Height" Value="67" />
    <Setter Property="MinHeight" Value="67" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.88" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.ribbon-command:pointerover">
    <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.ribbon-command:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.68" />
  </Style>
  <Style Selector="Button.ribbon-group-dropdown">
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="67" />
    <Setter Property="MinHeight" Value="67" />
    <Setter Property="Padding" Value="0,3" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.ribbon-group-dropdown:pointerover">
    <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ribbon-group-dropdown:pressed">
    <Setter Property="Background" Value="{StaticResource ChromeSelectedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.ribbon-gallery">
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#111F29" />
    <Setter Property="BorderBrush" Value="#3A5263" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #99000000" />
  </Style>
  <Style Selector="Button.ribbon-gallery-command">
    <Setter Property="Width" Value="98" />
    <Setter Property="Height" Value="80" />
    <Setter Property="MinHeight" Value="80" />
    <Setter Property="Padding" Value="2,5" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.ribbon-gallery-command:pointerover">
    <Setter Property="Background" Value="{StaticResource ChromeHoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ribbon-gallery-command:disabled">
    <Setter Property="Opacity" Value="0.74" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.panel-collapse">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.edge-reveal">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="#D9162733" />
    <Setter Property="BorderBrush" Value="#3B5568" />
  </Style>

  <Style Selector="Border.slide-thumbnail">
    <Setter Property="Background" Value="#101D27" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Border.slide-thumbnail:pointerover">
    <Setter Property="Background" Value="#162631" />
    <Setter Property="BorderBrush" Value="#3B5568" />
  </Style>
  <Style Selector="Border.slide-thumbnail.selected">
    <Setter Property="Background" Value="#132433" />
    <Setter Property="BorderBrush" Value="{StaticResource SelectionBrush}" />
  </Style>

  <Style Selector="Button.slide-navigator-item">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.slide-navigator-item:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.inspector-section-header">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Margin" Value="8,12,8,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#111E27" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Grid.property-row">
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="TextBlock.property-label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.property-number">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
  </Style>
  <Style Selector="Border.property-value">
    <Setter Property="Background" Value="#0A141C" />
    <Setter Property="BorderBrush" Value="#263744" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.property-unit">
    <Setter Property="Background" Value="#121F29" />
    <Setter Property="BorderBrush" Value="#263744" />
    <Setter Property="BorderThickness" Value="0,1,1,1" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.property-value TextBlock, Border.property-unit TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#0A141C" />
    <Setter Property="BorderBrush" Value="#344A5D" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Background" Value="#182833" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
</Styles>
