<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhysicaStudio.Desktop.ViewModels"
        xmlns:controls="using:PhysicaStudio.Desktop.Controls"
        x:Class="PhysicaStudio.Desktop.Views.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        Title="{Binding ApplicationTitle}"
        Width="1672" Height="941"
        MinWidth="1180" MinHeight="720"
        Background="{StaticResource ChromeBaseBrush}"
        WindowDecorations="None"
        WindowState="FullScreen"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="30,32,88,*,24">
    <!-- Custom title bar -->
    <Border Grid.Row="0"
            Background="{StaticResource ChromeDeepestBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="WindowTitleBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="8">
          <Border Width="20" Height="20" CornerRadius="3" Background="#123653" BorderBrush="#168CFF" BorderThickness="1">
            <controls:PhysicaIcon IconKey="physics" Width="14" Height="14" Stroke="#25C9C3"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Physica Studio" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Path Data="M 0,0 L 4,4 L 0,8"
                Width="5" Height="9" Stretch="Uniform"
                Stroke="#5F7484" StrokeThickness="1.25"
                VerticalAlignment="Center" Margin="2,1,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button Classes="title-tool" Click="SaveProject_Click" IsEnabled="{Binding CanSave}" ToolTip.Tip="Save project"><controls:PhysicaIcon IconKey="save" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
          <Button Classes="title-tool" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo"><controls:PhysicaIcon IconKey="undo" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
          <Button Classes="title-tool" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo"><controls:PhysicaIcon IconKey="redo" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DocumentTitle}" FontSize="12.5"
                   Foreground="#AFBEC9" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Classes="window-command" Click="MinimizeWindow_Click" ToolTip.Tip="Minimize">
            <Path Data="M 0,0 L 10,0" Stroke="#AAB7C1" StrokeThickness="1.2" />
          </Button>
          <Button Classes="window-command" Click="MaximizeWindow_Click" ToolTip.Tip="Restore window">
            <Rectangle Width="10" Height="8" Stroke="#AAB7C1" StrokeThickness="1.1" />
          </Button>
          <Button Classes="window-command close"
                  Click="CloseWindow_Click"
                  ToolTip.Tip="Exit Physica Studio"
                  AutomationProperties.Name="Exit Physica Studio">
            <Grid Width="10" Height="10">
              <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#AAB7C1" StrokeThickness="1.2" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Ribbon tabs -->
    <Border Grid.Row="1" Background="{StaticResource ChromeBaseBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RibbonTabs}" Margin="8,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RibbonTabViewModel">
                <Button Classes="ribbon-tab" Content="{Binding Label}"
                        Background="{Binding Background}" Foreground="{Binding Foreground}"
                        Click="RibbonTab_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Classes="title-tool" Click="ShowFeatureMap_Click" ToolTip.Tip="Feature Map">
            <controls:PhysicaIcon IconKey="list" Width="15" Height="15" Stroke="#8EA2B2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Ribbon band -->
    <Border Grid.Row="2" Background="{StaticResource ChromeRaisedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <ItemsControl ItemsSource="{Binding SelectedRibbonGroups}"
                    Margin="8,3,8,2"
                    HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RibbonGroupViewModel">
            <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,0">
                <Grid RowDefinitions="*,16">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding FeaturedCommands}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RibbonCommandViewModel">
                          <Button Classes="ribbon-command" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="{Binding Tooltip}"
                                  Click="RibbonCommand_Click">
                            <Grid RowDefinitions="28,*">
                              <controls:PhysicaIcon IconKey="{Binding Icon}" Width="21" Height="21"
                                                    Stroke="#C1CDD5" HorizontalAlignment="Center" />
                              <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="13" LineHeight="14"
                                         Foreground="#C4D0D8" TextWrapping="Wrap"
                                         TextAlignment="Center" MaxWidth="84" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                          Classes="ribbon-group-dropdown"
                          ToolTip.Tip="{Binding GalleryTooltip}"
                          AutomationProperties.Name="{Binding GalleryTooltip}">
                      <Grid RowDefinitions="28,*">
                        <controls:PhysicaIcon IconKey="more" Width="21" Height="21"
                                              Stroke="#AEBFCB" HorizontalAlignment="Center" />
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,8" HorizontalAlignment="Center">
                          <TextBlock Text="More" FontSize="13" Foreground="#C4D0D8" />
                          <Path Grid.Column="1" Data="M 1,1 L 4,4 L 7,1"
                                Stroke="#9EB0BD" StrokeThickness="1.2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                      <Button.Flyout>
                        <Flyout ShowMode="Standard">
                          <Border Classes="ribbon-gallery" Width="430" MaxHeight="440">
                            <Grid RowDefinitions="Auto,Auto,*">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#E6EDF2" />
                                <Border Grid.Column="1" Classes="readiness-badge" Padding="7,2">
                                  <TextBlock Text="{Binding GalleryStatus}" FontSize="10" Foreground="#9CB0BE" />
                                </Border>
                              </Grid>
                              <TextBlock Grid.Row="1" Text="{Binding GallerySummary}" Margin="0,2,0,10"
                                         FontSize="12" Foreground="#7F94A3" />
                              <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Commands}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RibbonCommandViewModel">
                                      <Button Classes="ribbon-gallery-command"
                                              IsEnabled="{Binding IsEnabled}"
                                              ToolTip.Tip="{Binding Tooltip}"
                                              Click="RibbonCommand_Click">
                                        <Grid RowDefinitions="30,*,15">
                                          <controls:PhysicaIcon IconKey="{Binding Icon}" Width="23" Height="23"
                                                                Stroke="#C2CFD8" HorizontalAlignment="Center" />
                                          <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="13" LineHeight="14"
                                                     Foreground="#D2DCE3" TextWrapping="Wrap"
                                                     TextAlignment="Center" MaxWidth="94" />
                                          <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="10"
                                                     Foreground="#718797" HorizontalAlignment="Center" />
                                        </Grid>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Grid>
                          </Border>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="12"
                             Foreground="#718493" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Authoring workspace -->
    <Grid x:Name="WorkspaceGrid" Grid.Row="3" Background="{StaticResource ChromeDeepestBrush}"
          IsVisible="{Binding IsProjectOpen}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="560" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="344" />
      </Grid.ColumnDefinitions>

      <!-- Slides -->
      <Border x:Name="LeftPanel" Grid.Column="0" Background="{StaticResource ChromeBaseBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="32,*,32">
          <Grid Margin="10,0,4,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Slides" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="panel-collapse" Click="ToggleLeftPanel_Click" ToolTip.Tip="Collapse slides">
              <Path Data="M 9,3 L 4,8 L 9,13" Stroke="#8193A0" StrokeThickness="1.4" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Slides}" Margin="8,4,8,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SlideItemViewModel">
                  <StackPanel>
                    <Border IsVisible="{Binding ShowSectionHeader}"
                            Margin="3,10,3,5"
                            Padding="6,4"
                            Background="#142731"
                            BorderBrush="#285064"
                            BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                        <Ellipse Width="6" Height="6" Fill="#25C9C3" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SectionName}" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="#BBD9E0" />
                      </Grid>
                    </Border>
                    <Grid DragDrop.AllowDrop="True"
                          DragDrop.DragOver="SlideItem_DragOver"
                          DragDrop.Drop="SlideItem_Drop">
                      <Button Classes="slide-navigator-item"
                              PointerPressed="SlideItem_PointerPressed"
                              Opacity="{Binding Opacity}"
                              AutomationProperties.Name="{Binding Name}">
                        <Border Background="{Binding Background}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="6">
                          <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{Binding NumberForeground}" />
                            <Border Grid.Column="1" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="#F8F9F7" CornerRadius="2" ClipToBounds="True">
                              <controls:DocumentSceneSurface Snapshot="{Binding Scene}" />
                            </Border>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding TextForeground}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                          </Grid>
                        </Border>
                      </Button>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                              Width="24" Height="24" Margin="0,6,6,0"
                              Background="#D912202B" CornerRadius="3"
                              Cursor="SizeAll"
                              PointerPressed="SlideDragHandle_PointerPressed"
                              AutomationProperties.Name="Drag to reorder slide">
                        <Path Data="M 7,7 L 17,7 M 7,12 L 17,12 M 7,17 L 17,17"
                              Stroke="#8FA0AD" StrokeThickness="1.4" />
                      </Border>
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0">
              <Button Classes="title-tool" Click="NewSlide_Click" ToolTip.Tip="New slide"><controls:PhysicaIcon IconKey="add" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
              <Button Classes="title-tool" Click="DuplicateSlide_Click" ToolTip.Tip="Duplicate selected slide"><controls:PhysicaIcon IconKey="duplicate" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
              <Button Classes="title-tool" Click="DeleteSlide_Click" ToolTip.Tip="Delete selected slide"><controls:PhysicaIcon IconKey="delete" Width="14" Height="14" Stroke="#8FA0AD" /></Button>
              <Button Classes="title-tool" Click="MoveSlideUp_Click" ToolTip.Tip="Move selected slide up">
                <Path Data="M 3,8 L 8,3 L 13,8" Stroke="#8FA0AD" StrokeThickness="1.4" />
              </Button>
              <Button Classes="title-tool" Click="MoveSlideDown_Click" ToolTip.Tip="Move selected slide down">
                <Path Data="M 3,4 L 8,9 L 13,4" Stroke="#8FA0AD" StrokeThickness="1.4" />
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" ResizeDirection="Columns" Background="#1C2B35" />

      <!-- Canvas and timeline -->
      <Grid x:Name="CenterGrid" Grid.Column="2" RowDefinitions="*,4,260" MinWidth="0">
        <Grid Grid.Row="0" Background="#0A1219">
          <Viewbox Margin="16" Stretch="Uniform">
            <Border Width="{Binding SlideLogicalWidth}" Height="{Binding SlideLogicalHeight}"
                    BorderBrush="#3A4650" BorderThickness="1"
                    BoxShadow="0 12 28 0 #99000000">
              <controls:DocumentSceneSurface Snapshot="{Binding ActiveScene}" />
            </Border>
          </Viewbox>
          <Button x:Name="ExpandLeftButton" Classes="edge-reveal" IsVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                  Click="ToggleLeftPanel_Click" ToolTip.Tip="Show slides">
            <Path Data="M 4,3 L 9,8 L 4,13" Stroke="#AFBEC9" StrokeThickness="1.4" />
          </Button>
          <Button x:Name="ExpandRightButton" Classes="edge-reveal" IsVisible="False"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                  Click="ToggleRightPanel_Click" ToolTip.Tip="Show inspector">
            <Path Data="M 9,3 L 4,8 L 9,13" Stroke="#AFBEC9" StrokeThickness="1.4" />
          </Button>
        </Grid>
        <GridSplitter x:Name="BottomSplitter" Grid.Row="1" ResizeDirection="Rows" Background="#1C2B35" />
        <Border x:Name="BottomPanel" Grid.Row="2" Background="{StaticResource ChromeBaseBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
          <Grid RowDefinitions="32,*">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0">
              <Button Classes="panel-collapse" Click="ToggleBottomPanel_Click" ToolTip.Tip="Collapse timeline">
                <Path Data="M 3,9 L 8,4 L 13,9" Stroke="#8193A0" StrokeThickness="1.4" />
              </Button>
              <TextBlock Grid.Column="1" Text="Timeline &amp; Keyframes" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" Margin="4,0" />
              <TextBlock Grid.Column="2" Text="{Binding TimelineSummary}" FontSize="12"
                         Foreground="#718493" VerticalAlignment="Center" Margin="0,0,8,0" />
            </Grid>
            <Grid Grid.Row="1">
              <controls:TimelinePreviewSurface x:Name="TimelineSurface"
                                               IsVisible="{Binding ShowStandingWaveReference}" />
              <StackPanel IsVisible="{Binding ShowEmptySlideContext}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <TextBlock Text="No timeline tracks on this slide" FontSize="13" Foreground="#91A2AE"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Timeline editing is planned for Phase 4" FontSize="11.5" Foreground="#647784"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Button x:Name="ExpandBottomButton" Grid.Row="2" Classes="edge-reveal" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Click="ToggleBottomPanel_Click" ToolTip.Tip="Show timeline">
          <Path Data="M 3,4 L 8,9 L 13,4" Stroke="#AFBEC9" StrokeThickness="1.4" />
        </Button>
      </Grid>

      <GridSplitter x:Name="RightSplitter" Grid.Column="3" ResizeDirection="Columns" Background="#1C2B35" />

      <!-- Inspector -->
      <Border x:Name="RightPanel" Grid.Column="4" Background="{StaticResource ChromeBaseBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="32,*">
          <Grid Margin="6,0,5,0" ColumnDefinitions="Auto,*,Auto">
            <Path Data="M 3,5 L 8,10 L 13,5" Stroke="#8193A0" StrokeThickness="1.3" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding InspectorTitle}" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="5,0" />
            <Button Grid.Column="2" Classes="panel-collapse" Click="ToggleRightPanel_Click" ToolTip.Tip="Collapse inspector">
              <Path Data="M 4,3 L 9,8 L 4,13" Stroke="#8193A0" StrokeThickness="1.4" />
            </Button>
          </Grid>
          <ScrollViewer x:Name="InspectorScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
            <StackPanel IsVisible="{Binding ShowStandingWaveReference}">
              <Border Classes="inspector-section-header">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                  <Path Data="M 2,3 L 7,8 L 12,3" Stroke="#91A2AE" StrokeThickness="1.3" />
                  <TextBlock Grid.Column="1" Text="Physics" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                </Grid>
              </Border>
              <StackPanel Margin="12,8,12,10" Spacing="4">
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Frequency (f)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="4.0" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="Hz" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Amplitude (A)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="1.0" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="cm" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Harmonic (n)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="2" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="n" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Wave speed (v)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="40.0" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="m/s" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Linear density (μ)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="0.010" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="kg/m" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*,58">
                  <TextBlock Text="Wavelength (λ)" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="10.0" Classes="property-number" /></Border>
                  <Border Grid.Column="2" Classes="property-unit"><TextBlock Text="m" /></Border>
                </Grid>
              </StackPanel>

              <Border Classes="inspector-section-header">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                  <Path Data="M 2,3 L 7,8 L 12,3" Stroke="#91A2AE" StrokeThickness="1.3" />
                  <TextBlock Grid.Column="1" Text="Appearance" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                </Grid>
              </Border>
              <StackPanel Margin="12,8,12,10" Spacing="4">
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Line style" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><Grid ColumnDefinitions="*,Auto"><Border Width="44" Height="3" Background="#168CFF" VerticalAlignment="Center" Margin="8,0" /><TextBlock Grid.Column="1" Text="Solid" Margin="0,0,8,0" VerticalAlignment="Center" /></Grid></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Line width" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="2.5 pt" Classes="property-number" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Color" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><Border Width="72" Height="13" Background="#168CFF" BorderBrush="#5AAEFF" BorderThickness="1" HorizontalAlignment="Left" Margin="8,0" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Node markers" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><Grid ColumnDefinitions="Auto,*"><Ellipse Width="8" Height="8" Fill="#168CFF" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Grid.Column="1" Text="Circle · 6 px" /></Grid></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Antinode markers" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><Grid ColumnDefinitions="Auto,*"><Ellipse Width="8" Height="8" Fill="#F29A2E" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Grid.Column="1" Text="Circle · 6 px" /></Grid></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Equilibrium line" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="— — —      1.0 pt" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Label placement" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="Automatic" /></Border>
                </Grid>
              </StackPanel>

              <Border Classes="inspector-section-header">
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                  <Path Data="M 2,3 L 7,8 L 12,3" Stroke="#91A2AE" StrokeThickness="1.3" />
                  <TextBlock Grid.Column="1" Text="Bindings" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
                </Grid>
              </Border>
              <StackPanel Margin="12,8,12,10" Spacing="4">
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Frequency" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Frequency control" /><controls:PhysicaIcon Grid.Column="1" IconKey="link" Width="14" Height="14" Stroke="#25C9C3" /></Grid></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Amplitude" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="Not bound" Foreground="#718493" /></Border>
                </Grid>
                <Grid Classes="property-row" ColumnDefinitions="116,*">
                  <TextBlock Text="Visibility" Classes="property-label" />
                  <Border Grid.Column="1" Classes="property-value"><TextBlock Text="Always" /></Border>
                </Grid>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1"
                      IsVisible="{Binding ShowEmptySlideContext}"
                      Margin="16,18"
                      Spacing="10">
            <Border Classes="inspector-section-header" Margin="0">
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Path Data="M 2,3 L 7,8 L 12,3" Stroke="#91A2AE" StrokeThickness="1.3" />
                <TextBlock Grid.Column="1" Text="Slide" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" />
              </Grid>
            </Border>
            <TextBlock Text="No objects on this slide" FontSize="13" Foreground="#AFBEC9" Margin="4,4,0,0" />
            <TextBlock Text="Canvas object insertion and editing will become available through the Phase 2 canvas checkpoint."
                       FontSize="11.5" Foreground="#718493" TextWrapping="Wrap" LineHeight="17" Margin="4,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Project start center: Close returns here; the title-bar Exit control ends the application. -->
    <Border Grid.Row="3"
            IsVisible="{Binding IsStartCenterVisible}"
            Background="#08131B">
      <Grid Margin="48" ColumnDefinitions="*,520,*" RowDefinitions="*,Auto,*">
        <Border Grid.Row="1" Grid.Column="1"
                Padding="34"
                Background="#101F29"
                BorderBrush="#2A3F4D"
                BorderThickness="1"
                CornerRadius="10"
                BoxShadow="0 16 36 0 #88000000">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Width="40" Height="40" Background="#123653" BorderBrush="#168CFF"
                      BorderThickness="1" CornerRadius="6">
                <controls:PhysicaIcon IconKey="slide" Width="22" Height="22" Stroke="#46A7FF"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding NoLessonOpenLabel}" FontSize="20" FontWeight="SemiBold" Foreground="#EDF3F7" />
                <TextBlock Text="{Binding StartCenterDescriptionLabel}" FontSize="12.5" Foreground="#91A2AE" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Classes="dialog-action" Click="NewFromStartCenter_Click"
                      AutomationProperties.Name="Create new lesson">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                  <controls:PhysicaIcon IconKey="add" Width="16" Height="16" Stroke="#DCECF7" />
                  <TextBlock Text="{Binding CreateNewLessonLabel}" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="dialog-action" Click="OpenFromStartCenter_Click"
                      AutomationProperties.Name="Open existing lesson">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                  <controls:PhysicaIcon IconKey="open" Width="16" Height="16" Stroke="#DCECF7" />
                  <TextBlock Text="{Binding OpenExistingLessonLabel}" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Height="1" Background="#263744" />
            <TextBlock Text="{Binding RecentLessonsLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#D7E2E9" />
            <TextBlock IsVisible="{Binding HasNoRecentProjects}" Text="{Binding NoRecentLessonsLabel}"
                       FontSize="12" Foreground="#718493" />
            <ItemsControl IsVisible="{Binding HasRecentProjects}" ItemsSource="{Binding RecentProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentProjectItemViewModel">
                  <Button Classes="recent-project" Click="OpenRecentProject_Click"
                          AutomationProperties.Name="{Binding DisplayName}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#EDF3F7" />
                      <controls:PhysicaIcon Grid.Column="1" Grid.RowSpan="2" IconKey="open" Width="15" Height="15"
                                            Stroke="#718493" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Text="{Binding Location}" FontSize="10.5" Foreground="#718493"
                                 TextTrimming="CharacterEllipsis" Margin="0,3,12,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border Grid.Row="4" Background="{StaticResource ChromeDeepestBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="9,0">
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8EA2B2" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Physics runtime: planned" FontSize="12" Foreground="#718493" />
            <Ellipse Width="7" Height="7" Fill="#E8B85B" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Project recovery: active" FontSize="12" Foreground="#52AFC9" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="#E8B85B" />
          <Border Width="1" Height="12" Background="#263744" />
          <TextBlock Text="100%" FontSize="12" Foreground="#AFBEC9" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
