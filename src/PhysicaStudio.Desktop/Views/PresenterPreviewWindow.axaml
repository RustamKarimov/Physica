<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PhysicaStudio.Desktop.Controls"
        x:Class="PhysicaStudio.Desktop.Views.PresenterPreviewWindow"
        Title="Physica Studio — Presentation Qualification"
        Width="1440" Height="900" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="44,*,62">
    <Border Background="#0C1620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <controls:PhysicaIcon IconKey="play" Width="17" Height="17" Stroke="#5ADACC" />
          <TextBlock Text="PRESENTATION QUALIFICATION" Classes="eyebrow" Foreground="#DCE8F1" VerticalAlignment="Center" />
          <Border Background="#3A3228" CornerRadius="4" Padding="6,2"><TextBlock Text="SHELL PREVIEW" FontSize="8.5" Foreground="#E9BD73" FontWeight="Bold" /></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
          <Button x:Name="DarkModeButton" Classes="physica-primary" Click="ShowDark_Click" Content="Dark explanation" />
          <Button x:Name="InteractiveModeButton" Click="ShowInteractive_Click" Content="Light investigation" />
        </StackPanel>
        <Button Grid.Column="2" Classes="quiet" Click="Close_Click" Content="Close preview" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="#050B11">
      <Grid x:Name="DarkPresentation">
        <Viewbox Margin="28" Stretch="Uniform">
          <Border Width="1000" Height="562.5" Background="#07121B" BoxShadow="0 16 44 0 #99000000">
            <controls:ScientificPreviewSurface PreviewKind="DarkPresentation" />
          </Border>
        </Viewbox>
      </Grid>

      <Grid x:Name="InteractivePresentation" IsVisible="False">
        <Viewbox Margin="28" Stretch="Uniform">
          <Grid Width="1000" Height="562.5">
            <controls:ScientificPreviewSurface PreviewKind="InteractivePresentation" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,145,48,0" Width="280" Height="198" Background="#F8FBFC" BorderBrush="#BFD0DA" BorderThickness="1" CornerRadius="9" BoxShadow="0 8 22 0 #33000000" Padding="15">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="CLASSROOM CONTROLS" Foreground="#607688" FontSize="10" FontWeight="Bold" /><Border Grid.Column="1" Background="#FFF0D6" CornerRadius="3" Padding="5,1"><TextBlock Text="PREVIEW" Foreground="#8A622A" FontSize="8" FontWeight="Bold" /></Border></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Launch speed" Foreground="#263E50" FontSize="13" /><TextBlock x:Name="SpeedValue" Grid.Column="1" Text="18.0 m/s" Foreground="#18776F" FontWeight="Bold" FontSize="13" /></Grid>
                <Slider x:Name="SpeedSlider" Minimum="5" Maximum="30" Value="18" ValueChanged="SpeedSlider_ValueChanged" />
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Launch angle" Foreground="#263E50" FontSize="13" /><TextBlock x:Name="AngleValue" Grid.Column="1" Text="42°" Foreground="#18776F" FontWeight="Bold" FontSize="13" /></Grid>
                <Slider x:Name="AngleSlider" Minimum="10" Maximum="80" Value="42" ValueChanged="AngleSlider_ValueChanged" />
                <Grid ColumnDefinitions="*,Auto"><CheckBox Content="Show velocity vectors" IsChecked="True" Foreground="#263E50" FontSize="13" /><Button Grid.Column="1" Content="Reset" Click="ResetControls_Click" Padding="9,3" /></Grid>
                <TextBlock Text="UI feedback only · physics binding activates in Phase 7" Foreground="#8A6A3D" FontSize="8.5" />
              </StackPanel>
            </Border>
          </Grid>
        </Viewbox>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#0D1822" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,*" Margin="16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
          <Button Classes="quiet tool" ToolTip.Tip="Pen · Planned Phase 5"><controls:PhysicaIcon IconKey="arrow" Width="15" Height="15" Stroke="#9BB0C0" /></Button>
          <Button Classes="quiet tool" ToolTip.Tip="Laser · Planned Phase 5"><controls:PhysicaIcon IconKey="physics" Width="15" Height="15" Stroke="#E66E76" /></Button>
          <TextBlock Text="Presentation ink will be ephemeral" Foreground="#8297A8" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Button Click="PreviousCheckpoint_Click" Padding="14,6" Content="Previous" />
          <Button Classes="physica-primary" Click="PlayCheckpoint_Click" Padding="18,6"><StackPanel Orientation="Horizontal" Spacing="7"><controls:PhysicaIcon IconKey="play" Width="14" Height="14" Stroke="White" /><TextBlock Text="Play to next checkpoint" /></StackPanel></Button>
          <Button Click="NextCheckpoint_Click" Padding="14,6" Content="Next" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
          <TextBlock x:Name="CheckpointText" Text="Checkpoint 2 of 5 · Reveal nodes" Foreground="#A9BBC8" FontSize="11" VerticalAlignment="Center" />
          <Border Background="#1B353A" BorderBrush="#2C6260" BorderThickness="1" CornerRadius="4" Padding="7,3"><TextBlock Text="DETERMINISTIC PREVIEW" Foreground="#68DDD0" FontSize="8.5" FontWeight="Bold" /></Border>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
