<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhysicaStudio.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://PhysicaStudio.Desktop/Themes/PhysicaTheme.axaml" />
  </Application.Styles>
</Application>
